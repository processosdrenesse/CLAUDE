# Só os dois TOKENS são obrigatórios (as URLs já têm valor padrão).
# Local: copie este arquivo para ".env" (sem .example) na pasta do projeto.
# Vercel: cadastre em Settings → Environment Variables e faça um novo Deploy.
BELLE_API_TOKEN=
LEVER_API_TOKEN=

# Opcional, mas necessário para Data de Inclusão/Cadastro dos agendamentos: token do BI do Belle
# (header Authorization da chamada BI/v1.0/report/build). É diferente do token de integração.
BELLE_BI_TOKEN=

# Opcional: exige senha (HTTP Basic) para acessar — use ao publicar.
DASHBOARD_PASSWORD=

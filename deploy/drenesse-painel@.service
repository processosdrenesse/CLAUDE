# Painel Drenesse — um serviço por ambiente: drenesse-painel@producao / drenesse-painel@homologacao
[Unit]
Description=Painel Drenesse (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drenesse
Group=drenesse
WorkingDirectory=/opt/drenesse/%i
# PORT, HOST, tokens e senha vêm do .env da pasta (lido pelo próprio servidor).
ExecStart=/opt/drenesse/%i/node_modules/.bin/tsx server/index.ts
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
